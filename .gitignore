# Local runtime/operator data - never commit to Git or deploy as source
runtime_data/

# Python local artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local secrets/environment files
.env
.env.*
!.env.example

# OS/editor temporary files
.DS_Store
Thumbs.db
*.tmp
*.temp

# Local SQLite/runtime state - Render creates its own database under NETWORK_AUTOMATION_DATA_DIR
database/*.db
database/*.db-wal
database/*.db-shm
database/*.lock
database/.credential.key
database/known_hosts
database/db_backups/
